# Copy this to .env.local for local development. On Netlify, set these under
# Site settings > Environment variables — never commit real values.

# Public URL of the deployed site (used for sitemap.xml / robots.txt).
SITE_URL=https://www.livincarolina.com

# Lofty CRM — buyer funnel only (see docs/lofty-integration.md; the seller
# funnel redirects straight to a Lofty-hosted page and needs no key here).
# Regenerate this key in Lofty before pasting it anywhere other than an env
# var, and set it directly in Netlify's UI rather than via an MCP connector
# — see the "Known issue" section in docs/lofty-integration.md.
LOFTY_API_KEY=
# Override only if Lofty's API base URL differs from the documented default.
# LOFTY_API_BASE_URL=https://api.lofty.com/v1.0
